# Configuração da Porta do Servidor API
PORT=3000

MONGO_URI="mongodb://localhost:27017/rpgDB"


# Conexão com o Banco de Dados (usando porta 5434 exposta pelo Docker para o Host local)
#DATABASE_URL=postgresql://postgres:polegadas5000@localhost:5434/rpgDB

# Chave Secreta para Assinatura e Verificação de Tokens JWT
JWT_SECRET=secretodemais

# Configurações de Conexão com o Redis (Local)
REDIS_HOST=localhost
REDIS_PORT=6379

# Configurações de Conexão com o RabbitMQ (Local)
RABBITMQ_URL=amqp://localhost:5672