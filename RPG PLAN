## 🗄️ 2. Schemas Mongoose Propostos

### A. `Habit` (Template / Definição do Hábito do Usuário)
```typescript
@Schema({ timestamps: true, collection: 'habits' })
export class Habit {
    @Prop({ type: Types.ObjectId, ref: 'User', required: true })
    user: Types.ObjectId;

    @Prop({ required: true, trim: true })
    title: string;

    @Prop({ type: String, enum: HabitCategory, required: true })
    category: HabitCategory; // WATER, NUTRITION, STUDY, MEDITATION, SLEEP, CUSTOM

    @Prop({ type: String, enum: StatTypeEnum, required: true })
    targetStat: StatTypeEnum; // strength, intelligence, vitality, focus

    @Prop({ default: 100 })
    xpReward: number;

    @Prop({ default: 10 })
    coinsReward: number;

    @Prop({ type: Object }) // Meta específica (ex: { targetValue: 2500, unit: 'ml' } ou { targetValue: 150, unit: 'g_protein' })
    goal: {
        targetValue: number;
        unit: string;
    };

    @Prop({ default: true })
    isDaily: boolean;

    @Prop({ type: [Number], default: [0, 1, 2, 3, 4, 5, 6] }) // Dias da semana ativos
    frequencyDays: number[];

    @Prop({ default: 0 })
    currentStreak: number;
}
```

### B. `DailyHabitLog` (Registro Diário de Progresso)
```typescript
@Schema({ timestamps: true, collection: 'daily_habit_logs' })
export class DailyHabitLog {
    @Prop({ type: Types.ObjectId, ref: 'User', required: true })
    user: Types.ObjectId;

    @Prop({ type: Types.ObjectId, ref: 'Habit', required: true })
    habit: Types.ObjectId;

    @Prop({ required: true }) // Data no formato YYYY-MM-DD
    date: string;

    @Prop({ default: 0 })
    currentProgress: number; // Ex: 1500ml de 2500ml

    @Prop({ default: false })
    isCompleted: boolean;
}
```

